# =============================================================================
# Catálogo de Edificações - Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para `.env` e preencha os valores reais.
# O `.env` NÃO deve ser commitado (adicione ao .gitignore).
#
# Em produção, defina essas variáveis diretamente no ambiente
# (Docker, Kubernetes, systemd, etc.).
# =============================================================================


# -----------------------------------------------------------------------------
# Profile ativo
# -----------------------------------------------------------------------------
# Define qual profile do Spring Boot será carregado.
# Valores comuns: dev, test, prod
# Default em application.yml: dev
#
# IMPORTANTE: quando PROFILE_ACTIVE=prod, os scripts de execução (run-linux.sh
# e run-windows.bat) passam -Pprod ao Maven para incluir o driver PostgreSQL
# no classpath. Em dev/test o H2 in-memory é usado automaticamente.
# -----------------------------------------------------------------------------
PROFILE_ACTIVE=dev


# -----------------------------------------------------------------------------
# PostgreSQL (apenas quando PROFILE_ACTIVE=prod)
# -----------------------------------------------------------------------------
# Datasource do banco PostgreSQL. Em dev/test o H2 in-memory é usado
# automaticamente e estas variáveis são ignoradas.
#
# Exemplo de HOST para PostgreSQL local:
#   jdbc:postgresql://localhost:5432
#
# Em Docker, troque "localhost" pelo host do container (ex.: db, postgres).
# Em Kubernetes, aponte para o Service do StatefulSet/Deployment do Postgres.
# -----------------------------------------------------------------------------
#DB_HOST=jdbc:postgresql://db:5432
#DB_NAME=catalogo_edificacoes
#DB_USERNAME=catalogo
#DB_PASSWORD=


# -----------------------------------------------------------------------------
# OAuth2 - Google
# -----------------------------------------------------------------------------
# Obtidos no Google Cloud Console em:
#   APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# O redirect URI configurado no Google deve ser:
#   {baseUrl}/login/oauth2/code/google
#   Exemplo dev: http://localhost:8080/login/oauth2/code/google
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# -----------------------------------------------------------------------------
# JWT - Caminhos das chaves RSA
# -----------------------------------------------------------------------------
# Apontando para arquivos .pem no disco. O conteúdo dos arquivos é lido
# no boot via ResourceUtils, parseando PEM (PKCS#8 para chave privada,
# X.509 para chave pública).
#
# Suporta prefixos:
#   - file:           caminho em filesystem (./.keys/public.pem, /etc/...)
#   - classpath:      recurso do classpath (src/main/resources/...)
#   - caminho puro:   tratado como file: implícito
#
# Gerar os arquivos (uma vez, ver docs/run.md):
#   mkdir -p ./keys
#   openssl genrsa -out ./.keys/private.pem 2048
#   openssl rsa -in ./.keys/private.pem -pubout -out ./.keys/public.pem
#   openssl pkcs8 -topk8 -in ./.keys/private.pem -out ./.keys/private_pkcs8.pem -nocrypt
#
# Os arquivos .pem NÃO devem ser commitados (adicione ./.keys/ ao .gitignore).
# Em Docker/Kubernetes, monte o diretório ./.keys/ como Secret.
# -----------------------------------------------------------------------------
JWT_PUBLIC_KEY_PATH=file:../.keys/public.pem
JWT_PRIVATE_KEY_PATH=file:../.keys/private_pkcs8.pem


# -----------------------------------------------------------------------------
# JWT - Expiração de tokens (em segundos)
# -----------------------------------------------------------------------------
# Access token: quanto tempo até o Bearer JWT expirar.
# Refresh token: quanto tempo até o refresh token (e seu cookie) expirar.
# O maxAge do cookie HttpOnly é derivado de JWT_REFRESH_EXPIRATION,
# mantendo coerência entre a vida do token persistido e a do cookie.
# -----------------------------------------------------------------------------
JWT_ACCESS_TOKEN_EXPIRATION=900
JWT_REFRESH_EXPIRATION=3600


# -----------------------------------------------------------------------------
# JWT - Segurança do cookie
# -----------------------------------------------------------------------------
# Quando true, o cookie HttpOnly só é enviado em conexões HTTPS.
# Em desenvolvimento local (HTTP), desligue para que o navegador aceite o cookie.
# Default: true
# Sobrescrito em application-dev.yml para false.
# -----------------------------------------------------------------------------
JWT_COOKIE_SECURE=true


# -----------------------------------------------------------------------------
# JWT - Política SameSite do cookie de refresh
# -----------------------------------------------------------------------------
# `Lax` é suficiente no modo integrado (frontend e backend na MESMA origem,
# com o Nginx fazendo o proxy de /auth/**). Só use `None` (exige
# JWT_COOKIE_SECURE=true) se frontend e backend ficarem em origens diferentes.
# Default em application.yml: Lax
# Referência: docs/arquitetura-frontend.md §14 e docs/seguranca.md.
# -----------------------------------------------------------------------------
JWT_COOKIE_SAME_SITE=Lax


# -----------------------------------------------------------------------------
# CORS - Origens cross-origin permitidas
# -----------------------------------------------------------------------------
# Lista separada por vírgula; vira List<String> em `cors.allowed-origins`.
# No modo integrado (Nginx) frontend e API são a MESMA origem — o SPA não passa
# por CORS. O valor abaixo cobre o dev com vite direto (5173) e o Nginx (8000).
#
# Prod:
#   CORS_ALLOWED_ORIGINS=https://catalogo.ifce.edu.br
#
# Vazio = nenhuma origem cross-origin permitida (default de produção).
# NUNCA use "*": com allowCredentials=true o Spring rejeita a combinação.
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=


# -----------------------------------------------------------------------------
# Frontend - Origem do backend (build da imagem Docker)
# -----------------------------------------------------------------------------
# Interpolada pelo docker-compose no build arg VITE_BACKEND_URL do frontend
# (ver docker-compose.yml e frontend/Dockerfile). O Vite substitui
# `import.meta.env.VITE_BACKEND_URL` em tempo de build
# (frontend/src/constants/routes.ts -> BACKEND_URL).
#
# DEIXE VAZIO no modo integrado (Nginx na mesma origem): o SPA chama /api,
# /auth, /oauth2 e /login/oauth2 relativamente, e o proxy do Nginx encaminha
# para o serviço `api`. URL completa só é necessária se o SPA for servido de
# uma origem diferente do backend (exige CORS no backend e CSP connect-src).
#
# Exemplo (origem separada — exceção, não é o modo padrão):
#   BACKEND_URL=https://api.catalogo.ifce.edu.br
# -----------------------------------------------------------------------------
BACKEND_URL=


# -----------------------------------------------------------------------------
# Frontend - URLs de callback OAuth2
# -----------------------------------------------------------------------------
# URLs para as quais o backend redireciona o navegador após o handshake
# OAuth2 com o Google (sucesso ou erro). Se vazias, o backend usa os
# defaults locais: /callback.html e /failure.html.
#
# Exemplo dev integrado (docker compose — Nginx na mesma origem do SPA):
#   FRONTEND_CALLBACK_SUCCESS_URL=http://localhost:8000/callback
#   FRONTEND_CALLBACK_ERROR_URL=http://localhost:8000/login
#
# Exemplo dev sem Nginx (backend direto — páginas estáticas do backend):
#   FRONTEND_CALLBACK_SUCCESS_URL=http://localhost:8080/callback.html
#   FRONTEND_CALLBACK_ERROR_URL=http://localhost:8080/failure.html
#
# Exemplo prod (SPA servida pelo Nginx do projeto):
#   FRONTEND_CALLBACK_SUCCESS_URL=https://catalogo.ifce.edu.br/callback
#   FRONTEND_CALLBACK_ERROR_URL=https://catalogo.ifce.edu.br/login
#
# O access token é anexado no fragmento da URL de sucesso (#token=...),
# garantindo que não seja enviado ao servidor em headers ou logs.
# -----------------------------------------------------------------------------
FRONTEND_CALLBACK_SUCCESS_URL=
FRONTEND_CALLBACK_ERROR_URL=


# -----------------------------------------------------------------------------
# Bootstrap do administrador institucional
# -----------------------------------------------------------------------------
# Email do usuário que será provisionado como administrador institucional
# no primeiro boot do sistema. OBRIGATÓRIO: a aplicação aborta o boot se
# esta variável não estiver configurada.
#
# O usuário é criado com ROLE_ADMINISTRADOR + ROLE_COLABORADOR.
# O CustomOAuth2UserService sincroniza o nome real a partir do Google
# no primeiro login.
#
# Para testes locais, pode-se usar qualquer email Google válido.
# Para produção, use o email institucional do setor de TI.
# Default em application-dev.yml: dev-admin@ifce.edu.br
# -----------------------------------------------------------------------------
BOOTSTRAP_ADMIN_EMAIL=


# -----------------------------------------------------------------------------
# Kill switch do bootstrap
# -----------------------------------------------------------------------------
# Quando false, o BootstrapAdminRunner é um no-op total: não cria,
# não reativa, não promove. Útil quando o operador precisa de uma
# desativação permanente do admin institucional sem remover a env var
# BOOTSTRAP_ADMIN_EMAIL.
# Default: true
# -----------------------------------------------------------------------------
BOOTSTRAP_ALLOW_REACTIVATE=true

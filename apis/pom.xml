<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>br.edu.ifce</groupId>
    <artifactId>catalogo-edificacoes-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>catalogo-edificacoes-parent</name>
    <description>POM raiz do projeto Catálogo de Edificações</description>

    <modules>
        <module>common-module</module>
        <module>security-module</module>
        <module>ambientes-internos-module</module>
        <module>main-app</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <kotlin.version>2.4.20</kotlin.version>
        <!--
          H2 2.4.240 (gerenciado pelo Boot 4.1.1) tem regressão na avaliação de CHECK constraints
          de colunas ENUM/discriminador quando a conexão que as criou é fechada (h2database#4291,
          #4323, #4342). 2.5.250 contém a correção. Remover este override quando o Boot passar a
          gerenciar uma versão corrigida.
        -->
        <h2.version>2.5.250</h2.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>br.edu.ifce</groupId>
                <artifactId>common-module</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.edu.ifce</groupId>
                <artifactId>security-module</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.edu.ifce</groupId>
                <artifactId>ambientes-internos-module</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <!--
                          Mockito inline mock maker: carrega o byte-buddy-agent como agente na JVM de testes.
                          O self-attach dinâmico falha no JDK 21+ (JEP 451) e em caminhos com espaço/acento no
                          Windows (perfil local); o -javaagent elimina a necessidade de attach em runtime.
                        -->
                        <argLine>
                            -javaagent:"${settings.localRepository}/net/bytebuddy/byte-buddy-agent/${byte-buddy.version}/byte-buddy-agent-${byte-buddy.version}.jar"
                            -XX:+EnableDynamicAgentLoading -Djdk.attach.allowAttachSelf=true
                        </argLine>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.jetbrains.kotlin</groupId>
                    <artifactId>kotlin-maven-plugin</artifactId>
                    <version>${kotlin.version}</version>
                    <configuration>
                        <args>
                            <arg>-Xjsr305=strict</arg>
                            <arg>-Xemit-jvm-type-annotations</arg>
                        </args>
                        <compilerPlugins>
                            <plugin>spring</plugin>
                            <plugin>jpa</plugin>
                            <plugin>all-open</plugin>
                        </compilerPlugins>
                        <pluginOptions>
                            <option>all-open:annotation=jakarta.persistence.Entity</option>
                            <option>all-open:annotation=jakarta.persistence.Embeddable</option>
                            <option>all-open:annotation=jakarta.persistence.MappedSuperclass</option>
                        </pluginOptions>
                    </configuration>
                    <dependencies>
                        <dependency>
                            <groupId>org.jetbrains.kotlin</groupId>
                            <artifactId>kotlin-maven-allopen</artifactId>
                            <version>${kotlin.version}</version>
                        </dependency>
                        <dependency>
                            <groupId>org.jetbrains.kotlin</groupId>
                            <artifactId>kotlin-maven-noarg</artifactId>
                            <version>${kotlin.version}</version>
                        </dependency>
                    </dependencies>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
